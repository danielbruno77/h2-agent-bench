FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Internal field: k = 1.5 (I Ub)^2 with I = 0.05, Ub = 5 m/s. Inlets recompute from patch U.
dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.094;

boundaryField
{
    "(inlet|port)"
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.05;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    walls
    {
        type            kqRWallFunction;
        value           $internalField;
    }
}

