FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Square duct D x D, length L (= 20D), along +x. Methane enters at x = 0.
// Square H2 port, wPort x wPort, flush on the y = 0 wall, centred at x = xPort
// and centred across the wall in z. Nine blocks (3 in x, 1 in y, 3 in z) so the
// port is exactly one block face.
//
//   z ^   wall y = 0, seen from below
//     |  +--------+----+-------------------------+ D
//     |  |        |    |                         |
//     |  +--------+----+-------------------------+ z2
//     |  | inlet  |port|                  outlet |
//     |  +--------+----+-------------------------+ z1
//     |  |        |    |                         |
//     |  +--------+----+-------------------------+ 0
//     +--0-------x1----x2------------------------L----> x

scale   1;

// Geometry (m)
L       2;
D       0.1;
xPort   0.2;
wPort   0.02;

// Resolution: total cells along x, across y, across z. Only these three and the
// port extents are changed by the mesh tool; per-block counts follow from them.
nx      200;    // 10 mm cells (coarse tier-1 baseline)
ny      10;
nz      10;

x1      #eval{ $xPort - 0.5*$wPort };
x2      #eval{ $xPort + 0.5*$wPort };
z1      #eval{ 0.5*($D - $wPort) };
z2      #eval{ 0.5*($D + $wPort) };

nx0     #eval{ round($nx*$x1/$L) };
nx1     #eval{ round($nx*$wPort/$L) };
nx2     #eval{ $nx - $nx0 - $nx1 };
nz0     #eval{ round($nz*$z1/$D) };
nz1     #eval{ round($nz*$wPort/$D) };
nz2     #eval{ $nz - $nz0 - $nz1 };

// Vertex index = i + 4*j + 8*k for x-station i, y-station j, z-station k.
vertices
(
    (  0  0   0)  ($x1  0   0)  ($x2  0   0)  ( $L  0   0)   // 0-3
    (  0 $D   0)  ($x1 $D   0)  ($x2 $D   0)  ( $L $D   0)   // 4-7
    (  0  0 $z1)  ($x1  0 $z1)  ($x2  0 $z1)  ( $L  0 $z1)   // 8-11
    (  0 $D $z1)  ($x1 $D $z1)  ($x2 $D $z1)  ( $L $D $z1)   // 12-15
    (  0  0 $z2)  ($x1  0 $z2)  ($x2  0 $z2)  ( $L  0 $z2)   // 16-19
    (  0 $D $z2)  ($x1 $D $z2)  ($x2 $D $z2)  ( $L $D $z2)   // 20-23
    (  0  0  $D)  ($x1  0  $D)  ($x2  0  $D)  ( $L  0  $D)   // 24-27
    (  0 $D  $D)  ($x1 $D  $D)  ($x2 $D  $D)  ( $L $D  $D)   // 28-31
);

blocks
(
    // z in [0, z1]
    hex ( 0  1  5  4  8  9 13 12) ($nx0 $ny $nz0) simpleGrading (1 1 1)
    hex ( 1  2  6  5  9 10 14 13) ($nx1 $ny $nz0) simpleGrading (1 1 1)
    hex ( 2  3  7  6 10 11 15 14) ($nx2 $ny $nz0) simpleGrading (1 1 1)
    // z in [z1, z2]; the middle block carries the port on its y = 0 face
    hex ( 8  9 13 12 16 17 21 20) ($nx0 $ny $nz1) simpleGrading (1 1 1)
    hex ( 9 10 14 13 17 18 22 21) ($nx1 $ny $nz1) simpleGrading (1 1 1)
    hex (10 11 15 14 18 19 23 22) ($nx2 $ny $nz1) simpleGrading (1 1 1)
    // z in [z2, D]
    hex (16 17 21 20 24 25 29 28) ($nx0 $ny $nz2) simpleGrading (1 1 1)
    hex (17 18 22 21 25 26 30 29) ($nx1 $ny $nz2) simpleGrading (1 1 1)
    hex (18 19 23 22 26 27 31 30) ($nx2 $ny $nz2) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            ( 0  8 12  4)
            ( 8 16 20 12)
            (16 24 28 20)
        );
    }

    port
    {
        type patch;
        faces
        (
            ( 9 10 18 17)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            ( 3  7 15 11)
            (11 15 23 19)
            (19 23 31 27)
        );
    }
);

defaultPatch
{
    name    walls;
    type    wall;
}

mergePatchPairs
(
);


