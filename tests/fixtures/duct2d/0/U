FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Bulk CH4 velocity Ub at the main inlet; H2 jet velocity Uj into the duct (+y) at the port.
Ub              5;
Uj              10;

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform ($Ub 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform ($Ub 0 0);
    }
    port
    {
        type            fixedValue;
        value           uniform (0 $Uj 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }
    walls
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}

