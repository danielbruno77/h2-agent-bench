FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Internal field: omega = sqrt(k)/(Cmu^0.25 l), Cmu = 0.09, l = 0.07 D = 0.007 m.
// Mixing length 0.07 x hydraulic diameter on each inlet (D = 0.1 m, port 0.02 m).
dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 80;

boundaryField
{
    inlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.007;
        value           $internalField;
    }
    port
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.0014;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    walls
    {
        type            omegaWallFunction;
        value           $internalField;
    }
    frontAndBack
    {
        type            empty;
    }
}

